rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if false; }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'soulimani.oualid@gmail.com' && request.auth.token.email_verified == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidUser(data) {
      return data.keys().hasAll(['fullName', 'email', 'createdAt', 'role'])
        && data.fullName is string && data.fullName.size() <= 100
        && data.email is string && data.email.size() <= 150
        && data.createdAt is string
        && data.role in ['customer', 'admin']
        && (!("phone" in data) || (data.phone is string && data.phone.size() <= 20))
        && (!("city" in data) || (data.city is string && data.city.size() <= 50))
        && (!("address" in data) || (data.address is string && data.address.size() <= 200));
    }

    match /users/{userId} {
      allow read: if isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow create: if isValidId(userId) && request.auth.uid == userId 
        && isValidUser(incoming())
        && incoming().role == 'customer';
      allow update: if isValidId(userId) && (
        (request.auth.uid == userId && isValidUser(incoming()) && incoming().role == existing().role)
        || isAdmin()
      );
    }

    function isValidOrderCustomer(data) {
      return data.keys().hasAll(['fullName', 'phone', 'city', 'address', 'paymentMethod'])
        && data.fullName is string && data.fullName.size() <= 100
        && data.phone is string && data.phone.size() <= 20
        && data.city is string && data.city.size() <= 50
        && data.address is string && data.address.size() <= 200
        && data.paymentMethod is string
        && (!("email" in data) || (data.email is string && data.email.size() <= 150))
        && (!("notes" in data) || (data.notes is string && data.notes.size() <= 500));
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['createdAt', 'customer', 'items', 'total', 'status'])
        && data.createdAt is string
        && isValidOrderCustomer(data.customer)
        && data.items is list
        && data.items.size() <= 50
        && data.total is number
        && data.status in ['pending', 'confirmed', 'shipping', 'delivered', 'cancelled']
        && (!("subtotal" in data) || data.subtotal is number)
        && (!("shippingFee" in data) || data.shippingFee is number)
        && (!("discountTotal" in data) || data.discountTotal is number)
        && (!("source" in data) || data.source is string)
        && (!("userId" in data) || (data.userId is string && data.userId.size() <= 128))
        && (!("adminNotes" in data) || (data.adminNotes is string && data.adminNotes.size() <= 500))
        && (!("emailNotified" in data) || data.emailNotified is bool);
    }

    match /orders/{orderId} {
      allow read: if isValidId(orderId) && (isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid));
      allow create: if isValidId(orderId) && isValidOrder(incoming()) && (
        (!("userId" in incoming()) || incoming().userId == null) || (isSignedIn() && incoming().userId == request.auth.uid)
      );
      allow update: if isValidId(orderId) && isAdmin() && isValidOrder(incoming());
      allow delete: if isValidId(orderId) && isAdmin();
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /images/{imageId} {
      allow read: if true;
      allow create, update: if isValidId(imageId);
      allow delete: if isValidId(imageId);
    }
  }
}
