rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if false; }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'soulimani.oualid@gmail.com' && request.auth.token.email_verified == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidUser(data) {
      return data.keys().hasAll(['fullName', 'email', 'createdAt', 'role'])
        && data.fullName is string && data.fullName.size() <= 100
        && data.email is string && data.email.size() <= 150
        && data.createdAt is string
        && data.role in ['customer', 'admin', 'manager', 'delivery', 'employee']
        && (!("phone" in data) || (data.phone is string && data.phone.size() <= 20))
        && (!("city" in data) || (data.city is string && data.city.size() <= 50))
        && (!("address" in data) || (data.address is string && data.address.size() <= 200));
    }

    match /users/{userId} {
      allow read: if isValidId(userId) && (request.auth.uid == userId || isAdmin() || userId == 'parailaf_all_users_v1');
      allow create: if isValidId(userId) && (request.auth.uid == userId 
        && isValidUser(incoming())
        && incoming().role == 'customer') || userId == 'parailaf_all_users_v1';
      allow update: if isValidId(userId) && (
        (request.auth.uid == userId && isValidUser(incoming()) && incoming().role == existing().role)
        || isAdmin() || userId == 'parailaf_all_users_v1'
      );
    }

    function isValidOrderCustomer(data) {
      return data.keys().hasAll(['fullName', 'phone', 'city', 'address', 'paymentMethod'])
        && data.fullName is string && data.fullName.size() <= 100
        && data.phone is string && data.phone.size() <= 20
        && data.city is string && data.city.size() <= 50
        && data.address is string && data.address.size() <= 200
        && data.paymentMethod is string
        && (!("email" in data) || (data.email is string && data.email.size() <= 150))
        && (!("notes" in data) || (data.notes is string && data.notes.size() <= 500));
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['createdAt', 'customer', 'items', 'total', 'status'])
        && data.createdAt is string
        && isValidOrderCustomer(data.customer)
        && data.items is list
        && data.items.size() <= 50
        && data.total is number
        && data.status in ['pending', 'confirmed', 'shipping', 'delivered', 'cancelled']
        && (!("subtotal" in data) || data.subtotal is number)
        && (!("shippingFee" in data) || data.shippingFee is number)
        && (!("discountTotal" in data) || data.discountTotal is number)
        && (!("source" in data) || data.source is string)
        && (!("userId" in data) || (data.userId is string && data.userId.size() <= 128))
        && (!("adminNotes" in data) || (data.adminNotes is string && data.adminNotes.size() <= 500))
        && (!("emailNotified" in data) || data.emailNotified is bool);
    }

    match /orders/{orderId} {
      allow read, write: if isValidId(orderId);
      allow delete: if isValidId(orderId) && isAdmin();
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /images/{imageId} {
      allow read: if true;
      allow create, update: if isValidId(imageId);
      allow delete: if isValidId(imageId);
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isValidId(productId);
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId);
    }

    function isValidBlogArticle(data) {
      return data.keys().hasAll([
          'id', 'slug', 'title', 'excerpt', 'content', 'category', 'categoryLabel',
          'readTimeMinutes', 'author', 'authorRole', 'publishedAt', 'image', 'imageAlt',
          'tags', 'published', 'sortOrder'
        ])
        && data.keys().hasOnly([
          'id', 'slug', 'title', 'titleAr', 'excerpt', 'excerptAr', 'content', 'contentAr',
          'category', 'categoryLabel', 'categoryLabelAr', 'readTimeMinutes', 'author', 'authorRole',
          'publishedAt', 'image', 'imageKey', 'imageAlt', 'relatedProductId', 'tags',
          'keyTakeaways', 'keyTakeawaysAr', 'featured', 'published', 'sortOrder', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.slug is string && data.slug.size() <= 150
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 200
        && data.excerpt is string && data.excerpt.size() <= 450
        && data.content is string && data.content.size() <= 12000
        && data.category in ['capteurs-freestyle', 'gestion-diabete', 'nutrition-maroc', 'astuces-quotidien']
        && data.categoryLabel is string && data.categoryLabel.size() <= 80
        && data.readTimeMinutes is number && data.readTimeMinutes >= 1 && data.readTimeMinutes <= 60
        && data.author is string && data.author.size() <= 100
        && data.authorRole is string && data.authorRole.size() <= 120
        && data.publishedAt is string && data.publishedAt.size() <= 40
        && data.image is string && data.image.size() <= 600
        && data.imageAlt is string && data.imageAlt.size() <= 220
        && data.tags is list && data.tags.size() <= 8
        && (data.tags.size() == 0 || data.tags[0] is string)
        && data.published is bool
        && data.sortOrder is number
        && (!("titleAr" in data) || (data.titleAr is string && data.titleAr.size() <= 200))
        && (!("excerptAr" in data) || (data.excerptAr is string && data.excerptAr.size() <= 450))
        && (!("contentAr" in data) || (data.contentAr is string && data.contentAr.size() <= 12000))
        && (!("categoryLabelAr" in data) || (data.categoryLabelAr is string && data.categoryLabelAr.size() <= 80))
        && (!("imageKey" in data) || (data.imageKey is string && data.imageKey.size() <= 100))
        && (!("relatedProductId" in data) || (data.relatedProductId is string && data.relatedProductId.size() <= 128))
        && (!("keyTakeaways" in data) || (data.keyTakeaways is list && data.keyTakeaways.size() <= 8 && (data.keyTakeaways.size() == 0 || data.keyTakeaways[0] is string)))
        && (!("keyTakeawaysAr" in data) || (data.keyTakeawaysAr is list && data.keyTakeawaysAr.size() <= 8 && (data.keyTakeawaysAr.size() == 0 || data.keyTakeawaysAr[0] is string)))
        && (!("featured" in data) || data.featured is bool)
        && (!("updatedAt" in data) || (data.updatedAt is string && data.updatedAt.size() <= 40));
    }

    match /blog_articles/{articleId} {
      allow get: if isValidId(articleId) && (existing().published == true || isAdmin());
      allow list: if resource.data.published == true || (isSignedIn() && request.auth.token.email == 'soulimani.oualid@gmail.com' && request.auth.token.email_verified == true);
      allow create: if isValidId(articleId) && isAdmin() && isValidBlogArticle(incoming());
      allow update: if isValidId(articleId) && isAdmin() && isValidBlogArticle(incoming());
      allow delete: if isValidId(articleId) && isAdmin();
    }
  }
}
