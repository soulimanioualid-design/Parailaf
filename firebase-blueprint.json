{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile containing personal information and preferences.",
      "type": "object",
      "properties": {
        "fullName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 20 },
        "city": { "type": "string", "maxLength": 50 },
        "address": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string" },
        "role": { "type": "string", "enum": ["customer", "admin", "manager", "delivery", "employee"] }
      },
      "required": ["fullName", "email", "createdAt", "role"]
    },
    "Order": {
      "title": "Order",
      "description": "An e-commerce order containing customer info and cart items.",
      "type": "object",
      "properties": {
        "createdAt": { "type": "string" },
        "customer": {
          "type": "object",
          "properties": {
            "fullName": { "type": "string", "maxLength": 100 },
            "phone": { "type": "string", "maxLength": 20 },
            "city": { "type": "string", "maxLength": 50 },
            "address": { "type": "string", "maxLength": 200 },
            "email": { "type": "string", "maxLength": 150 },
            "paymentMethod": { "type": "string" }
          },
          "required": ["fullName", "phone", "city", "address", "paymentMethod"]
        },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "shippingFee": { "type": "number" },
        "discountTotal": { "type": "number" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "shipping", "delivered", "cancelled"] },
        "source": { "type": "string" },
        "userId": { "type": "string", "maxLength": 128 },
        "adminNotes": { "type": "string", "maxLength": 500 }
      },
      "required": ["createdAt", "customer", "items", "total", "status"]
    },
    "AppImage": {
      "title": "AppImage",
      "description": "Stores custom promotional flyers, banner, and catalog product images synchronized across devices.",
      "type": "object"
    },
    "CatalogProduct": {
      "title": "CatalogProduct",
      "description": "Stores e-commerce catalog product data and customizations.",
      "type": "object"
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Stores general site configuration including language toggles.",
      "type": "object"
    },
    "BlogArticle": {
      "title": "BlogArticle",
      "description": "Educational advice article on diabetes management and FreeStyle Libre sensor usage.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "slug": { "type": "string", "maxLength": 150 },
        "title": { "type": "string", "maxLength": 200 },
        "titleAr": { "type": "string", "maxLength": 200 },
        "excerpt": { "type": "string", "maxLength": 450 },
        "excerptAr": { "type": "string", "maxLength": 450 },
        "content": { "type": "string", "maxLength": 12000 },
        "contentAr": { "type": "string", "maxLength": 12000 },
        "category": { "type": "string", "enum": ["capteurs-freestyle", "gestion-diabete", "nutrition-maroc", "astuces-quotidien"] },
        "categoryLabel": { "type": "string", "maxLength": 80 },
        "categoryLabelAr": { "type": "string", "maxLength": 80 },
        "readTimeMinutes": { "type": "number" },
        "author": { "type": "string", "maxLength": 100 },
        "authorRole": { "type": "string", "maxLength": 120 },
        "publishedAt": { "type": "string", "maxLength": 40 },
        "image": { "type": "string", "maxLength": 600 },
        "imageKey": { "type": "string", "maxLength": 100 },
        "imageAlt": { "type": "string", "maxLength": 220 },
        "relatedProductId": { "type": "string", "maxLength": 128 },
        "tags": { "type": "array" },
        "keyTakeaways": { "type": "array" },
        "keyTakeawaysAr": { "type": "array" },
        "featured": { "type": "boolean" },
        "published": { "type": "boolean" },
        "sortOrder": { "type": "number" },
        "updatedAt": { "type": "string", "maxLength": 40 }
      },
      "required": [
        "id",
        "slug",
        "title",
        "excerpt",
        "content",
        "category",
        "categoryLabel",
        "readTimeMinutes",
        "author",
        "authorRole",
        "publishedAt",
        "image",
        "imageAlt",
        "tags",
        "published",
        "sortOrder"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profiles."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Stores e-commerce orders."
    },
    "/images/{imageId}": {
      "schema": { "$ref": "#/entities/AppImage" },
      "description": "Stores custom promotional and flyer image data synchronized across devices."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/CatalogProduct" },
      "description": "Stores products catalog and individual product customizations."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/SiteSettings" },
      "description": "Stores site settings and language enablement."
    },
    "/blog_articles/{articleId}": {
      "schema": { "$ref": "#/entities/BlogArticle" },
      "description": "Stores diabetes management and FreeStyle Libre advice articles."
    }
  }
}
